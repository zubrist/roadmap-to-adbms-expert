    {
      "id": "zhpBbAhuyD2sYBJe_f83q",
      "type": "text",
      "x": 425.1624784469605,
      "y": 1101.3274670931983,
      "width": 712.572998046875,
      "height": 190.72314962549547,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
