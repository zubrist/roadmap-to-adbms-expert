      "seed": 187416010,
      "version": 382,
      "versionNonce": 629158678,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794843426613,
      "link": null,
      "locked": false,
      "text": "DML:\nUsed for retrieving/accessing and manipulating data in db\n\n-> SELECT : used to access data from db\n-> INSERT: used to insert data in table \n-> UPDAT: used to update the records in ",
      "fontSize": 25.429753283399396,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DML:\nUsed for retrieving/accessing and manipulating data in db\n\n-> SELECT : used to access data from db\n-> INSERT: used to insert data in table \n-> UPDAT: used to update the records in ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "crLLmErKUQWAFOnrEr6-a",
      "type": "text",
      "x": 443.58124065399176,
      "y": 945.9146312316274,
      "width": 569.9796752929688,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1154809878,
      "version": 339,
      "versionNonce": 545868054,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794842440328,
      "link": null,
      "locked": false,
      "text": "-> CREATE : to create the structure of new object in db.\n-> ALTER : used to change/update the structure \n-> DROP: used to delete object/table from db\n-> TRUNCATE : used to remove all records from a table \n-> RENAME: used to rename a object",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> CREATE : to create the structure of new object in db.\n-> ALTER : used to change/update the structure \n-> DROP: used to delete object/table from db\n-> TRUNCATE : used to remove all records from a table \n-> RENAME: used to rename a object",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yNv9ClpYTdw7u3Q2NQ5xC",
      "type": "text",
      "x": 425.000002861023,
      "y": 1351.0000663042094,
      "width": 527.3196411132812,
      "height": 125,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 141059786,
      "version": 115,
      "versionNonce": 1704521802,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794843713324,
      "link": null,
      "locked": false,
      "text": "DCL\n\n-> GRANT : used to give user access privileges to db.\n-> REVOKE : to take back the previleges\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DCL\n\n-> GRANT : used to give user access privileges to db.\n-> REVOKE : to take back the previleges\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
