      "boundElements": null,
      "updated": 1794844019170,
      "link": null,
      "locked": false,
      "text": "TCL\n-> Commit : used to save the committed transection on the database.\n-> Rollback: used to restore the db to the original state since last commit.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TCL\n-> Commit : used to save the committed transection on the database.\n-> Rollback: used to restore the db to the original state since last commit.",
      "autoResize": true,
      "lineHeight": 1.25
    }
