      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 1937253027,
      "version": 172,
      "versionNonce": 1833766467,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789192179039,
      "link": null,
      "locked": false,
      "text": "External Level (View Level):\n Includes user views. Each schema\ndescribes only the part of the\ndatabase a specific user group cares\nabout and hides the rest",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "External Level (View Level):\n Includes user views. Each schema describes only the part of the database a specific user group cares about and hides the rest",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "F5rTFOFjFWrdILHmyDM3Y",
      "type": "text",
      "x": 375.5874967575073,
      "y": 1742.8291743199036,
      "width": 389.2987060546875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 746776205,
      "version": 206,
      "versionNonce": 79742125,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789192398639,
      "link": null,
      "locked": false,
      "text": "Conceptual Level (Logical Level):\nDescribes the logical structure of the\nentire database for all users.\nHides physical storage details and\nconcentrates on entities, data types,\nrelationships, and constraints",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Conceptual Level (Logical Level):\nDescribes the logical structure of the entire database for all users.\nHides physical storage details and concentrates on entities, data types, relationships, and constraints",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "T41IrGPqUeBhY-29BzRUc",
      "type": "text",
      "x": 371.5812406539917,
      "y": 1930.4104426304505,
      "width": 389.2987060546875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 329189325,
      "version": 243,
      "versionNonce": 1730620909,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789192547468,
      "link": null,
      "locked": false,
      "text": "Internal Level (Physical Level):\ndescribes the physical storage\nstructure, file allocation, record\nformats, and indexing access paths on\ndisk",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Internal Level (Physical Level):\ndescribes the physical storage structure, file allocation, record formats, and indexing access paths on disk",
      "autoResize": false,
      "lineHeight": 1.25
    }
  ],
