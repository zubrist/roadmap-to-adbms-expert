    {
      "id": "WtHE3kLXfZtYKXBkDX7Hq",
      "type": "text",
      "x": 377.1937589645386,
      "y": 1602.0479243199036,
      "width": 389.2987060546875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
