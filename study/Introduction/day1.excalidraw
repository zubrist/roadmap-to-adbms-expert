      "isDeleted": false,
      "boundElements": null,
      "updated": 1789191469586,
      "link": null,
      "locked": false,
      "text": "#### The Core Characteristics of the DBMS Approach",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#### The Core Characteristics of the DBMS Approach",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5IvOlt6AdI0DUJWiiZKq4",
      "type": "text",
      "x": 356.2677335739137,
      "y": 1118.6624697923658,
      "width": 815.8333129882814,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 1331301133,
      "version": 133,
      "versionNonce": 1772383939,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789191497493,
      "link": null,
      "locked": false,
      "text": "Self-Describing Nature: The DBMS stores complete definitions of database\nstructures and constraints (metadata) in a central catalog",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Self-Describing Nature: The DBMS stores complete definitions of database structures and constraints (metadata) in a central catalog",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5X_pAhO6YrvETI6BVPc5r",
      "type": "text",
      "x": 359.25143718719494,
      "y": 1189.2437075853345,
      "width": 753.0532836914062,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 1936308291,
      "version": 154,
      "versionNonce": 1755618787,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789191560205,
      "link": null,
      "locked": false,
      "text": "Insulation Between Programs and Data (Program-Data Independence):\nStructure of data files is stored in the catalog separately from access\nprograms",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Insulation Between Programs and Data (Program-Data Independence): Structure of data files is stored in the catalog separately from access programs",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "BMXccSsVyjS2G08Bs9-I3",
      "type": "text",
      "x": 366.2764310836792,
      "y": 1283.068796086311,
      "width": 785.3533325195312,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 459219309,
      "version": 330,
      "versionNonce": 964616131,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789191650844,
      "link": null,
      "locked": false,
      "text": "Support for Multiple User Views: Different users see different customized\nsubsets or virtual representations of the database",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Support for Multiple User Views: Different users see different customized subsets or virtual representations of the database",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Ve09Po98DUznni_gndAju",
      "type": "text",
      "x": 363.45273113250744,
      "y": 1354.5874575853345,
      "width": 793.8132934570311,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 649050083,
      "version": 247,
      "versionNonce": 512370467,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789191800358,
      "link": null,
      "locked": false,
      "text": "Multi-User Transaction Processing: Concurrency control ensures multiple users\ncan update data simultaneously without interfering with each other",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Multi-User Transaction Processing: Concurrency control ensures multiple users can update data simultaneously without interfering with each other",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "gmecP1MmcD0le6mCQaGhr",
      "type": "text",
      "x": 370.8439054489137,
      "y": 1502.7479060093567,
      "width": 444.69970703125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 1298660771,
      "version": 59,
      "versionNonce": 227855395,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789191948371,
      "link": null,
      "locked": false,
      "text": "The Three-Schema ANSI/SPARC Architecture",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Three-Schema ANSI/SPARC Architecture",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5vnV3Qd6BLhNwMhhukoYO",
      "type": "image",
      "x": 789.8584216435751,
