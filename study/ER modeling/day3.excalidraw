      "isDeleted": false,
      "boundElements": null,
      "updated": 1795016863921,
      "link": null,
      "locked": false,
      "text": "2) Overlapping Constraint\n\nAn entity may belong to multiple subclasses simultaneously .\n\nExample : \n\n                    Faculties\n\n\nProfessors                                Researchers \n\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Overlapping Constraint\n\nAn entity may belong to multiple subclasses simultaneously .\n\nExample : \n\n                    Faculties\n\n\nProfessors                                Researchers \n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f8gVFZdyRuRJGmuGJbGTC",
      "type": "text",
      "x": 400.03769230018446,
      "y": 3204.4052960264426,
      "width": 480.3515319824219,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0h",
      "roundness": null,
      "seed": 1616830192,
      "version": 217,
      "versionNonce": 1405335280,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795017369089,
      "link": null,
      "locked": false,
      "text": "3) Completness Constraint \n\ntwo types : 1) total Specialization\n                2) partial Specialization\n\n==> Total Specilization\n\nEvery Superclass entity must belong to at least one subclass\n\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3) Completness Constraint \n\ntwo types : 1) total Specialization\n                2) partial Specialization\n\n==> Total Specilization\n\nEvery Superclass entity must belong to at least one subclass\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
