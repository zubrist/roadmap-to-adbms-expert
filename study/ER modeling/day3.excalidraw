    },
    {
      "id": "m_qtlx1ZBNC_mTRK4Mjxz",
      "type": "text",
      "x": 414.5863981601253,
      "y": -827.0194409681068,
      "width": 693.8893111603671,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 672602655,
      "version": 208,
      "versionNonce": 284726833,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795011507811,
      "link": null,
      "locked": false,
      "text": "It is a top-down approach in data modeling where a higher-level, more\ngeneralized entity (superclass) is divided into multiple lower-level, more\nspecific entities (subclasses).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is a top-down approach in data modeling where a higher-level, more generalized entity (superclass) is divided into multiple lower-level, more specific entities (subclasses).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5Nj7wvsVs7D8cRhnJNWq-",
      "type": "text",
      "x": 402.6939532025847,
      "y": -723.9586508548114,
      "width": 687.699462890625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1558317745,
      "version": 143,
      "versionNonce": 1745487121,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795011510243,
      "link": null,
      "locked": false,
      "text": "-> The subclass inherit all attributes of the superclass and may have \n    additional attributes of their own.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> The subclass inherit all attributes of the superclass and may have \n    additional attributes of their own.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iYlbe4UiDgSX-VvqkIH_q",
      "type": "text",
      "x": 401.10177128462453,
      "y": -654.8458394631641,
      "width": 726.699462890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1364516241,
      "version": 71,
      "versionNonce": 1350691505,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795011515261,
      "link": null,
      "locked": false,
      "text": "-> It allows us to define more specific entities from a more general entity.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> It allows us to define more specific entities from a more general entity.",
      "autoResize": true,
      "lineHeight": 1.25
    },
