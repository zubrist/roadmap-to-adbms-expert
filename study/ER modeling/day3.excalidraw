    {
      "id": "1wn8LZA_eFVMC2hUG6L5i",
      "type": "text",
      "x": 388.20247612475833,
      "y": 2549.4791711935973,
      "width": 346.3036804199219,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 1220971248,
      "version": 175,
      "versionNonce": 2141402640,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795016626815,
      "link": null,
      "locked": false,
      "text": "1) Disjoint constraint \n\n-> An entity can belong to only one subclass\n\nExample :\n\n\n    Employee \n\n\nManager                      Developer ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Disjoint constraint \n\n-> An entity can belong to only one subclass\n\nExample :\n\n\n    Employee \n\n\nManager                      Developer ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oaPnhoxszbASN3iSBDZ1P",
      "type": "text",
      "x": 475.4922377547299,
      "y": 2798.9507755408267,
      "width": 453.7275695800781,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 311406096,
      "version": 143,
      "versionNonce": 1108988432,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795016691940,
      "link": null,
      "locked": false,
      "text": "A record from Employee can be either in Manager table or \nin Developer table but cant be in both table.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A record from Employee can be either in Manager table or \nin Developer table but cant be in both table.",
      "autoResize": true,
      "lineHeight": 1.25
    },
